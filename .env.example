# Copy this file to .env for local development and replace the placeholders.
# Do not commit .env or put the service-role key in the frontend.

# Supabase Session Pooler connection string (port 5432)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Generate a long random value; never reuse or publish this secret.
JWT_SECRET=replace-with-a-long-random-secret

# Supabase project URL and backend-only service-role key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_BUCKET=assignment-submissions

# Groq is optional for local mock operation; set a key for real verification/grading.
GROQ_API_KEY=
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
GROQ_MODEL_VERIFY=openai/gpt-oss-20b
GROQ_MODEL_GRADE_FAST=openai/gpt-oss-20b
GROQ_MODEL_GRADE_REASONING=openai/gpt-oss-120b
GROQ_MODEL_VISION=

# Local Vite origin. Add the exact production frontend origin in Render's environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and verification settings
MAX_UPLOAD_BYTES=10485760
EXCEL_MAX_ROWS=2000
EXCEL_MAX_CELLS=50000
EXCEL_MAX_CONSECUTIVE_EMPTY_ROWS=50
ROSTER_TOPIC_MAX_CHARS=500
ROSTER_CONFIRM_MAX_ROWS=500
VERIFICATION_MIN_CONTENT_CHARS=50
VERIFICATION_MISMATCH_THRESHOLD=0.75
VERIFICATION_RATE_LIMIT=5
VERIFICATION_RATE_WINDOW_HOURS=1
VERIFICATION_REQUEST_TIMEOUT=15
